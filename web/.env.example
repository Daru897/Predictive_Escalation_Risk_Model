# Copy to .env.local for local private workspaces. npm start loads it.
PORT=3001
HOSTNAME=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3001
DATABASE_PATH=data/monitor.sqlite
COOKIE_SECURE=false
# Generate a strong setup key; only administrators need this to create workspaces.
SETUP_KEY=
# Generate with: openssl rand -hex 32. Keep stable and back it up securely.
TOKEN_ENCRYPTION_KEY=
